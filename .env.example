# 后端监听端口；Docker 镜像内固定 8080 并由 nginx 反代，无需改动
PORT=8080
# 管理员账号，首次部署后请修改
ADMIN_USERNAME=admin
# 管理员密码，首次部署后请修改
ADMIN_PASSWORD=infinite-canvas
# 登录态签名密钥，留空则每次启动随机生成，重启后已登录状态失效
JWT_SECRET=
# 登录态有效期（小时），默认 7 天
JWT_EXPIRE_HOURS=168
# 数据库：sqlite | mysql | postgres
STORAGE_DRIVER=sqlite
# sqlite 填文件路径；mysql/postgres 填标准 URL，如 mysql://user:pass@host:3306/dbname
# Docker 部署填 /app/data/infinite-canvas.db，数据才会落在挂载卷里
DATABASE_DSN=data/infinite-canvas.db
# 数据目录，留空时 sqlite 跟随数据库文件所在目录
DATA_DIR=
# 对外可访问地址，供火山方舟等上游回源读取参考素材，不配会退回 base64 提交
PUBLIC_BASE_URL=
# 允许的跨域来源，* 表示不限制
CORS_ORIGIN=*
# 文件存储：local | s3
FILE_DRIVER=local
# 以下 S3_* 仅在 FILE_DRIVER=s3 时需要，S3 兼容服务的接入地址
S3_ENDPOINT=
# 存储区域，多数 S3 兼容服务填 auto 即可
S3_REGION=auto
# 存储桶名称
S3_BUCKET=
# 访问密钥 ID
S3_ACCESS_KEY_ID=
# 访问密钥
S3_SECRET_ACCESS_KEY=
# 是否使用 path-style 地址，MinIO 等自建服务通常需要
S3_FORCE_PATH_STYLE=true
# 对象键前缀，留空则放在存储桶根目录
S3_PREFIX=
# 生成任务并发数
JOB_CONCURRENCY=4
# 以下 Linux.do OAuth 地址一般不用改
LINUX_DO_AUTHORIZE_URL=https://connect.linux.do/oauth2/authorize
LINUX_DO_TOKEN_URL=https://connect.linux.do/oauth2/token
LINUX_DO_USERINFO_URL=https://connect.linux.do/api/user
